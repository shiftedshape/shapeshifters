---
import ProductCard from './ProductCard.astro';
import { categories, type Product } from '../lib/catalog';

interface Props {
  kicker: string;
  title: string;
  intro?: string;
  products: Product[];
  active?: string;
  search?: boolean;
}

const { kicker, title, intro, products, active = 'all', search = false } = Astro.props;
const tabs = [
  { key: 'all', label: 'All', href: '/shop/' },
  ...Object.entries(categories).map(([key, c]) => ({ key, label: c.nav, href: `/shop/${key}/` })),
];
---

<section class="wrap head">
  <p class="kicker">{kicker}</p>
  <h1>{title}</h1>
  {intro && <p class="intro">{intro}</p>}
  <nav aria-label="Categories" class="tabs">
    {
      tabs.map((t) => (
        <a href={t.href} aria-current={t.key === active ? 'page' : undefined}>
          {t.label}
        </a>
      ))
    }
  </nav>
  {
    search && (
      <form role="search" class="filter" data-filter>
        <label for="shop-q" class="sr-only">Search products</label>
        <input id="shop-q" name="q" type="search" class="field" placeholder="Search templates, brushes, textures…" />
      </form>
    )
  }
</section>

<section class="wrap results">
  <p class="count" aria-live="polite" data-count>{products.length} products</p>
  <div class="grid" data-grid>
    {products.map((p) => <ProductCard product={p} />)}
  </div>
  <p class="empty" data-empty hidden>Nothing matches that yet. Try another word, or <a href="#join">tell us what to make next</a>.</p>
</section>

{
  search && (
    <script>
      const form = document.querySelector<HTMLFormElement>('[data-filter]');
      const input = form?.querySelector('input');
      const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-grid] [data-search]'));
      const count = document.querySelector('[data-count]');
      const empty = document.querySelector<HTMLElement>('[data-empty]');

      function apply(q: string) {
        const words = q.toLowerCase().split(/\s+/).filter(Boolean);
        let shown = 0;
        for (const card of cards) {
          const hay = card.dataset.search ?? '';
          const hit = words.every((w) => hay.includes(w));
          card.hidden = !hit;
          if (hit) shown++;
        }
        if (count) count.textContent = `${shown} product${shown === 1 ? '' : 's'}`;
        if (empty) empty.hidden = shown > 0;
      }

      if (form && input) {
        const initial = new URLSearchParams(location.search).get('q') ?? '';
        input.value = initial;
        apply(initial);
        form.addEventListener('submit', (e) => e.preventDefault());
        input.addEventListener('input', () => {
          apply(input.value);
          const url = new URL(location.href);
          if (input.value) url.searchParams.set('q', input.value);
          else url.searchParams.delete('q');
          history.replaceState(null, '', url);
        });
      }
    </script>
  )
}

<style>
  .head {
    padding-top: 40px;
  }
  h1 {
    font-size: clamp(40px, 5vw, 64px);
  }
  .intro {
    margin: 16px 0 0;
    font-size: 18px;
    color: var(--body);
    max-width: 600px;
  }
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }
  .tabs a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    background: var(--paper);
  }
  .tabs a[aria-current='page'] {
    background: var(--ink);
    color: #fff;
  }
  .filter {
    margin-top: 16px;
    display: flex;
    max-width: 560px;
  }
  .results {
    padding-top: 32px;
  }
  .count {
    margin: 0 0 16px;
    font-size: 14px;
    color: var(--muted);
  }
  .grid :global([hidden]) {
    display: none;
  }
  .empty {
    font-size: 17px;
  }
</style>
