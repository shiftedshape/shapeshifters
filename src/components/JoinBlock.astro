---
/** Newsletter signup. Uses Netlify Forms out of the box; see README to connect a newsletter tool. */
---

<section id="join" class="wrap section">
  <div class="join">
    <div class="copy">
      <h2>Join the Shapeshifters.</h2>
      <p>Get a free texture pack now, plus new drops and tutorials by email. Buyers get a role in our Discord.</p>
    </div>
    <form name="newsletter" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="company">
      <input type="hidden" name="form-name" value="newsletter" />
      <p class="sr-only"><label>Leave this empty <input name="company" tabindex="-1" autocomplete="off" /></label></p>
      <label for="join-email" class="sr-only">Email address</label>
      <input id="join-email" class="field" type="email" name="email" required placeholder="you@studio.com" autocomplete="email" />
      <button type="submit" class="btn btn-ink">Send me the pack</button>
    </form>
  </div>
</section>

<style>
  .join {
    background: var(--lime);
    border: 1.5px solid var(--ink);
    border-radius: 32px;
    padding: clamp(32px, 5vw, 56px) clamp(24px, 4vw, 40px);
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    align-items: center;
    justify-content: space-between;
  }
  .copy {
    flex: 1 1 420px;
    min-width: 0;
  }
  h2 {
    font-size: clamp(36px, 5vw, 52px);
    line-height: 1;
  }
  .copy p {
    margin: 16px 0 0;
    font-size: 18px;
    max-width: 480px;
  }
  form {
    flex: 1 1 380px;
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  form .btn {
    min-height: 52px;
  }
</style>
