---
import Thumb from './Thumb.astro';
import { categories, collectionsInfo, tools, priceLabel, type Product } from '../lib/catalog';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const d = product.data;
const price = priceLabel(product);
// Only a collection gets a tag on the card; the category is already the page you're on
const tag = d.collection !== 'none' ? collectionsInfo[d.collection].name : undefined;
const search = [d.title, d.summary, d.excerpt, categories[d.category].nav, categories[d.category].section, d.collection, ...d.tools.map((t) => tools[t]), d.free ? 'free' : '', d.comingSoon ? 'soon' : '']
  .join(' ')
  .toLowerCase();
---

<a href={`/products/${product.id}/`} class:list={['card', { soon: d.comingSoon }]} data-search={search} data-tools={d.tools.join(' ')}>
  <Thumb color={d.color} motif={d.motif} image={d.cover} video={d.coverVideo} alt="" tag={tag} />
  <div class="meta">
    <div>
      <h3>{d.title}</h3>
      <p>{d.summary}</p>
    </div>
    <span class:list={['pill', { 'pill-lime': d.free && !d.comingSoon, 'pill-lilac': d.comingSoon }]}>{price}</span>
  </div>
</a>

<style>
  .card {
    text-decoration: none;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: var(--ink);
    color: var(--ink);
  }
  .soon :global(.thumb) {
    opacity: 0.7;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    padding: 0 4px 4px;
  }
  h3 {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.3;
  }
  p {
    margin: 3px 0 0;
    font-size: 14px;
    color: var(--muted);
  }
  .pill {
    flex: none;
    font-size: 13px;
  }
  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
    .card:hover {
      transform: none;
    }
  }
</style>
