---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import site from '../data/site.json';
import { categories, sections, typesIn, typeCounts, lessonKinds, type SectionKey, type LessonKind } from '../lib/catalog';

const path = Astro.url.pathname;
const counts = await typeCounts();
const lessons = await getCollection('tutorials');

type Item = { label: string; href: string; soon?: boolean };
type Menu = { key: string; label: string; href: string; items: Item[]; all: Item };

// Graphics, Templates, Web: their types (empty ones say "Soon"). Learn: lesson kinds plus the tools list.
const menus: Menu[] = [
  ...(Object.keys(sections) as SectionKey[]).map((k) => ({
    key: k,
    label: sections[k].label,
    href: `/${k}/`,
    items: typesIn(k).map((t) => ({ label: categories[t].nav, href: `/${k}/${t}/`, soon: counts[t] === 0 })),
    all: { label: sections[k].all, href: `/${k}/` },
  })),
  {
    key: 'learn',
    label: 'Learn',
    href: '/learn/',
    items: [
      ...(Object.keys(lessonKinds) as LessonKind[]).map((k) => ({
        label: lessonKinds[k].nav,
        href: lessonKinds[k].href,
        soon: !lessons.some((l) => l.data.kind === k),
      })),
      { label: 'Tools we use', href: '/learn/tools/' },
    ],
    all: { label: 'Everything in Learn', href: '/learn/' },
  },
];
const isCurrent = (href: string) => path.startsWith(href);
---

{
  site.announcement.show && site.announcement.text && (
    <div class="announce">
      <a href={site.announcement.link || '#'}>{site.announcement.text}</a>
    </div>
  )
}

<header class="wrap site-header" data-header>
  <a href="/" class="brand">
    <Logo />
    <span>{site.name}</span>
  </a>
  <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
    <span class="bars" aria-hidden="true"><i></i><i></i></span>
    Menu
  </button>
  <nav id="site-nav" aria-label="Main">
    <ul class="menus">
      {
        menus.map((m) => (
          <li class="menu" data-menu>
            <a href={m.href} class="top" aria-current={isCurrent(m.href) ? 'page' : undefined}>
              {m.label}
            </a>
            <button type="button" class="caret" aria-expanded="false" aria-controls={`dd-${m.key}`} data-caret>
              <span class="sr-only">{m.label} menu</span>
              <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
                <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
              </svg>
            </button>
            <div class="dropdown" id={`dd-${m.key}`}>
              <ul>
                {m.items.map((it) =>
                  it.soon ? (
                    <li>
                      <span class="soon">
                        {it.label} <em>Soon</em>
                      </span>
                    </li>
                  ) : (
                    <li>
                      <a href={it.href} aria-current={path === it.href ? 'page' : undefined}>
                        {it.label}
                      </a>
                    </li>
                  ),
                )}
              </ul>
              <a href={m.all.href} class="all">
                {m.all.label} →
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </nav>
  <a href="/#pricing" class="btn btn-ink cta">Get all-access</a>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menus = Array.from(header?.querySelectorAll<HTMLElement>('[data-menu]') ?? []);

  const closeAll = (except?: HTMLElement) =>
    menus.forEach((m) => {
      if (m === except) return;
      m.classList.remove('open');
      m.querySelector('[data-caret]')?.setAttribute('aria-expanded', 'false');
    });

  // Mobile: the Menu button opens the whole navigation
  toggle?.addEventListener('click', () => {
    const open = header!.classList.toggle('nav-open');
    toggle.setAttribute('aria-expanded', String(open));
  });

  // Desktop: the small arrow opens a dropdown for keyboard and touch (hover opens it for mice)
  menus.forEach((m) => {
    const caret = m.querySelector<HTMLButtonElement>('[data-caret]');
    caret?.addEventListener('click', () => {
      const open = !m.classList.contains('open');
      closeAll(m);
      m.classList.toggle('open', open);
      caret.setAttribute('aria-expanded', String(open));
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAll();
  });
  document.addEventListener('click', (e) => {
    if (!header?.contains(e.target as Node)) closeAll();
  });
</script>

<style>
  .announce {
    background: var(--lime);
    padding: 10px var(--gutter);
    text-align: center;
    font-size: 14px;
    font-weight: 500;
  }
  .announce a {
    color: var(--ink);
  }
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 28px;
    padding-block: 20px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.02em;
  }
  .menus {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 6px 28px;
    font-size: 15px;
    font-weight: 500;
  }
  .menu {
    position: relative;
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .top {
    text-decoration: none;
    padding-block: 10px;
  }
  .top[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
  }
  .caret {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
    border-radius: 6px;
  }
  .caret svg {
    transition: transform 0.15s ease;
  }
  .menu.open .caret svg {
    transform: rotate(180deg);
  }
  .dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: -18px;
    z-index: 20;
    min-width: 240px;
    padding: 10px;
    background: var(--paper);
    border: 1.5px solid var(--ink);
    border-radius: 18px;
    box-shadow: 0 12px 30px rgb(0 0 0 / 0.08);
  }
  /* an invisible bridge so the dropdown stays open while the pointer moves down into it */
  .dropdown::before {
    content: '';
    position: absolute;
    inset: -12px 0 auto 0;
    height: 12px;
  }
  @media (hover: hover) and (min-width: 861px) {
    .menu:hover .dropdown {
      display: block;
    }
  }
  .menu.open .dropdown,
  .menu:focus-within .dropdown {
    display: block;
  }
  .dropdown ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .dropdown a,
  .dropdown .soon {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 12px;
    border-radius: 10px;
    text-decoration: none;
    white-space: nowrap;
  }
  .dropdown a:hover,
  .dropdown a[aria-current='page'] {
    background: var(--lime);
    color: var(--ink);
  }
  .dropdown .soon {
    color: var(--muted);
  }
  .dropdown .soon em {
    font-style: normal;
    font-size: 12px;
    background: var(--lilac);
    color: var(--ink);
    border-radius: 999px;
    padding: 2px 8px;
  }
  .dropdown .all {
    margin-top: 6px;
    border-top: 1px solid var(--line);
    border-radius: 0 0 10px 10px;
    font-weight: 600;
  }
  .menu-toggle {
    display: none;
    align-items: center;
    gap: 10px;
    font: inherit;
    font-weight: 600;
    min-height: 44px;
    padding: 0 16px;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
  }
  .bars {
    display: grid;
    gap: 5px;
  }
  .bars i {
    display: block;
    width: 16px;
    height: 2px;
    background: currentColor;
    transition: transform 0.15s ease;
  }
  .nav-open .bars i:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .nav-open .bars i:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* Phones and small tablets: a Menu button that opens every section with its types listed */
  @media (max-width: 860px) {
    .menu-toggle {
      display: inline-flex;
      margin-left: auto;
    }
    .cta {
      display: none;
    }
    nav {
      display: none;
      order: 3;
      width: 100%;
    }
    .nav-open nav {
      display: block;
    }
    .nav-open .cta {
      display: inline-flex;
      order: 4;
    }
    .menus {
      flex-direction: column;
      gap: 18px;
      padding: 8px 0 4px;
    }
    .menu {
      flex-wrap: wrap;
    }
    .top {
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 700;
      padding-block: 4px;
    }
    .caret {
      display: none;
    }
    .dropdown,
    .menu:focus-within .dropdown {
      display: block;
      position: static;
      width: 100%;
      min-width: 0;
      padding: 4px 0 0;
      border: 0;
      box-shadow: none;
      background: none;
    }
    .dropdown::before,
    .dropdown .all {
      display: none;
    }
    .dropdown ul {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .dropdown a,
    .dropdown .soon {
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 8px 14px;
      font-size: 14px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .caret svg,
    .bars i {
      transition: none;
    }
  }
</style>
