---
// A before/after slider: drag (or use the arrow keys) to move the split; with a mouse it follows the pointer.
interface Props {
  after: string;
  before: string;
  alt: string;
  label?: string; // shown on the right, e.g. the effect's name
  eager?: boolean;
}
const { after, before, alt, label = 'After', eager = false } = Astro.props;
const loading = eager ? 'eager' : 'lazy';
---

<div class="ba" style="--pos:50%" data-ba>
  <img src={after} alt={alt} loading={loading} decoding="async" />
  <img class="ba-before" src={before} alt="" aria-hidden="true" loading={loading} decoding="async" />
  <span class="ba-line" aria-hidden="true"><span class="ba-knob">‹ ›</span></span>
  <span class="pill ba-tag ba-l" aria-hidden="true">Before</span>
  <span class="pill pill-lime ba-tag ba-r" aria-hidden="true">{label}</span>
  <input type="range" min="0" max="100" value="50" step="0.5" aria-label={`Before and after: ${alt}`} />
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((box) => {
    const range = box.querySelector<HTMLInputElement>('input[type=range]');
    if (!range || box.dataset.ready) return;
    box.dataset.ready = '1';
    const set = (v: number) => box.style.setProperty('--pos', `${v}%`);
    range.addEventListener('input', () => set(+range.value));
    box.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      const r = box.getBoundingClientRect();
      const v = Math.min(100, Math.max(0, ((e.clientX - r.left) / r.width) * 100));
      range.value = String(v);
      set(v);
    });
  });
</script>

<style>
  .ba {
    position: relative;
    border: 1.5px solid var(--ink);
    border-radius: var(--radius-lg);
    /* clip-path keeps the rounded corners crisp in every browser, also over the clipped before image */
    clip-path: inset(0 round var(--radius-lg));
    overflow: hidden;
    isolation: isolate;
    background: #151515;
    touch-action: pan-y;
    cursor: ew-resize;
  }
  .ba img {
    display: block;
    width: 100%;
    height: auto;
    user-select: none;
    -webkit-user-drag: none;
  }
  .ba .ba-before {
    position: absolute;
    inset: 0;
    height: 100%;
    object-fit: cover;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  .ba-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: #fff;
    pointer-events: none;
  }
  .ba-knob {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #fff;
    color: var(--ink);
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 15px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.25);
  }
  .ba-tag {
    position: absolute;
    bottom: 14px;
    pointer-events: none;
  }
  .ba-l {
    left: 14px;
  }
  .ba-r {
    right: 14px;
  }
  .ba input[type='range'] {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }
  .ba:has(input:focus-visible) .ba-knob {
    outline: 3px solid var(--lime);
    outline-offset: 2px;
  }
</style>
