---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import JoinBlock from '../components/JoinBlock.astro';
import PolarEmbed from '../components/PolarEmbed.astro';
import site from '../data/site.json';
import { categories, collectionsInfo, getProducts, priceLabel, type CategoryKey } from '../lib/catalog';

// Brushes & textures first: that's where the real packs are
const rowOrder: CategoryKey[] = ['brushes', 'templates', 'social'];
const rows = await Promise.all(
  rowOrder.map(async (key) => ({
    key,
    ...categories[key],
    items: (await getProducts((p) => p.data.category === key && p.data.featured)).slice(0, 4),
  })),
);

const bundle = await getEntry('products', 'texture-bundle');
const lessons = (await getCollection('tutorials'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const perks = [
  { n: '01', bg: 'lime', title: 'Built in Affinity Studio', text: 'Native files with layers, styles and swatches intact.' },
  { n: '02', bg: 'lilac', title: 'Pay once, keep it', text: 'No subscription needed for single packs.' },
  { n: '03', bg: 'lime', title: 'Free packs to start', text: 'Try the quality before you spend a cent.' },
  { n: '04', bg: 'lilac', title: 'Tutorials included', text: 'Every pack comes with a how-to.' },
];
const popular = ['halftone', 'riso', 'carousel', 'brand board'];
---

<Base>
  <section class="wrap hero">
    <div class="hero-copy">
      <p class="pill pill-lilac eyebrow">Made for Affinity Studio</p>
      <h1>Assets for designers who <span class="mark">switched.</span></h1>
      <p class="lede">{site.description}</p>
      <form role="search" action="/shop/" method="get" class="search">
        <label for="q" class="sr-only">Search the supply</label>
        <input id="q" name="q" type="search" placeholder="Search templates, brushes, textures…" />
        <button type="submit" class="btn btn-ink">Search</button>
      </form>
      <div class="popular">
        <span>Popular:</span>
        {popular.map((term) => <a href={`/shop/?q=${encodeURIComponent(term)}`}>{term}</a>)}
      </div>
    </div>
    <div class="collage" aria-hidden="true">
      <div class="c c1"><img src="/images/hero-offset.webp" alt="" /><span>Offset textures</span></div>
      <div class="c c2"><i class="dot"></i><i class="sq"></i><span>Detach starter kit</span></div>
      <div class="c c3">
        <div class="chips"><i></i><i></i><i></i></div>
        <strong>Social pack · 30 slides</strong>
      </div>
    </div>
  </section>

  <section aria-label="Why Shapeshifters" class="perks">
    <div class="wrap perks-grid">
      {
        perks.map((p) => (
          <div class="perk">
            <span class:list={['num', `bg-${p.bg}`]}>{p.n}</span>
            <div>
              <strong>{p.title}</strong>
              <p>{p.text}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  {
    rows.map((row) => (
      <section id={row.key} class="wrap section">
        <div class="section-head">
          <div>
            <p class="kicker">{row.label}</p>
            <h2>{row.title}</h2>
          </div>
          <a href={`/shop/${row.key}/`}>Explore all →</a>
        </div>
        <div class="grid">
          {row.items.map((p) => <ProductCard product={p} />)}
        </div>
        {row.key === 'brushes' && bundle && !bundle.data.comingSoon && (
          <a href={`/products/${bundle.id}/`} class="bundle-strip">
            <img src={bundle.data.cover} alt="" loading="lazy" />
            <span class="bundle-copy">
              <strong>{bundle.data.title}: all four packs</strong>
              <span>{bundle.data.excerpt}</span>
            </span>
            <span class="pill pill-lime bundle-price">{priceLabel(bundle)}</span>
          </a>
        )}
      </section>
    ))
  }

  <section aria-label="Collections" class="wrap section collections">
    <div class="panel bg-lilac">
      <div class="decor" aria-hidden="true"><i class="halftone"></i></div>
      <p class="kicker">Collection</p>
      <h2>{collectionsInfo.offset.name}</h2>
      <p>{collectionsInfo.offset.text}</p>
      <a href="/collections/offset/" class="btn btn-ink">Shop Offset</a>
    </div>
    <div class="panel panel-ink">
      <div class="decor" aria-hidden="true"><i class="d1"></i><i class="d2"></i></div>
      <p class="kicker">Collection</p>
      <h2>{collectionsInfo.detach.name}</h2>
      <p>{collectionsInfo.detach.text}</p>
      <a href="/collections/detach/" class="btn btn-lime">Get the kit</a>
    </div>
  </section>

  <section id="learn" class="wrap section">
    <div class="section-head">
      <div>
        <p class="kicker">Learn</p>
        <h2>Tutorials for every pack</h2>
      </div>
      <a href="/learn/">All tutorials →</a>
    </div>
    <div class="lessons">
      {
        lessons.map((l) => (
          <a href={`/learn/${l.id}/`} class="lesson">
            <span class:list={['pill', `pill-${l.data.color === 'lime' ? 'lime' : 'lilac'}`]}>{l.data.tag}</span>
            <strong>{l.data.title}</strong>
            <span class="text">{l.data.excerpt}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section id="pricing" class="wrap section">
    <div class="center-head">
      <h2>Buy one pack, or unlock them all</h2>
      <p>Every file is yours to keep. Prices include VAT where it applies.</p>
    </div>
    <div class="plans">
      {
        site.plans.map((pl) => {
          const allAccess = pl.name === 'All-access' && site.allAccess.live && site.allAccess.checkoutUrl;
          return (
            <div class:list={['plan', `plan-${pl.style}`]}>
              <div class="plan-top">
                <h3>{pl.name}</h3>
                {pl.badge && !allAccess && <span class="pill pill-lime">{pl.badge}</span>}
              </div>
              <div class="price">
                {pl.price}
                {pl.per && <span> {pl.per}</span>}
              </div>
              <ul>
                {pl.features.map((f) => (
                  <li>
                    <span aria-hidden="true">✓</span>
                    {f}
                  </li>
                ))}
              </ul>
              <a
                href={allAccess ? site.allAccess.checkoutUrl : pl.link}
                class:list={['btn', 'btn-block', pl.style === 'ink' ? 'btn-lime' : 'btn-ink']}
                data-polar-checkout={allAccess && site.checkoutOverlay ? '' : undefined}
                data-polar-checkout-theme={allAccess ? 'light' : undefined}
              >
                {allAccess ? 'Get all-access' : pl.cta}
              </a>
            </div>
          );
        })
      }
    </div>
  </section>

  <section aria-label="Questions" class="wrap section faq">
    <h2>Questions</h2>
    {
      site.faq.map((q) => (
        <details>
          <summary>
            {q.q}
            <span aria-hidden="true">+</span>
          </summary>
          <p>{q.a}</p>
        </details>
      ))
    }
  </section>

  <JoinBlock />
  <PolarEmbed />
</Base>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: center;
    padding-top: 56px;
    padding-bottom: 72px;
  }
  .hero-copy {
    flex: 1 1 520px;
    min-width: 0;
  }
  .eyebrow {
    margin: 0 0 20px;
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 6px 14px;
  }
  h1 {
    font-size: clamp(44px, 6vw, 84px);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  .mark {
    background: var(--lime);
    padding: 0 10px;
    border-radius: 14px;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .lede {
    margin: 24px 0 32px;
    font-size: 19px;
    color: var(--body);
    max-width: 520px;
  }
  .search {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    background: var(--paper);
    border: 1.5px solid var(--ink);
    border-radius: 32px;
    padding: 6px;
    max-width: 560px;
  }
  .search input {
    flex: 1 1 220px;
    min-width: 0;
    border: 0;
    background: transparent;
    padding: 0 16px;
    font: inherit;
    font-size: 16px;
    min-height: 44px;
    border-radius: 999px;
  }
  .popular {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
    align-items: center;
    font-size: 14px;
  }
  .popular span {
    color: var(--muted);
  }
  .popular a {
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 6px 12px;
    text-decoration: none;
  }

  .collage {
    flex: 1 1 440px;
    min-width: 0;
    position: relative;
    height: 460px;
  }
  .c {
    position: absolute;
    border: 1.5px solid var(--ink);
    border-radius: 24px;
    overflow: hidden;
  }
  .c span {
    position: absolute;
    left: 24px;
    bottom: 24px;
  }
  .c1 span {
    bottom: auto;
    top: 24px;
  }
  .c1 img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .c span {
    border-radius: 12px;
    padding: 10px 14px;
    font-weight: 600;
    font-size: 14px;
    background: var(--paper);
  }
  .c1 {
    left: 4%;
    top: 30px;
    width: 58%;
    height: 340px;
    background: var(--lilac) radial-gradient(rgba(21, 21, 21, 0.35) 1.4px, transparent 1.8px) 0 0 / 11px 11px;
    transform: rotate(-6deg);
  }
  .c2 {
    right: 2%;
    top: 0;
    width: 50%;
    height: 300px;
    background: var(--ink);
    transform: rotate(5deg);
  }
  .c2 .dot {
    position: absolute;
    left: 28px;
    top: 28px;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: var(--lime);
  }
  .c2 .sq {
    position: absolute;
    left: 96px;
    top: 96px;
    width: 120px;
    height: 120px;
    border-radius: 18px;
    border: 2px solid var(--lilac);
  }
  .c2 span {
    background: var(--lime);
  }
  .c3 {
    left: 30%;
    bottom: 0;
    width: 46%;
    height: 200px;
    background: var(--lime);
    transform: rotate(-1.5deg);
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .chips {
    display: flex;
    gap: 8px;
  }
  .chips i {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--ink);
  }
  .chips i:nth-child(2) {
    background: var(--lilac);
  }
  .chips i:nth-child(3) {
    background: var(--paper);
  }
  .c3 strong {
    font-family: var(--font-display);
    font-size: 26px;
    line-height: 1.05;
  }
  @media (max-width: 640px) {
    .collage {
      height: 360px;
    }
    .c1 {
      height: 260px;
    }
    .c2 {
      height: 230px;
    }
    .c3 {
      height: 160px;
      width: 60%;
      left: 20%;
    }
  }

  .bundle-strip {
    margin-top: 20px;
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 12px 24px 12px 12px;
    background: var(--ink);
    color: #fff;
    border-radius: var(--radius);
    text-decoration: none;
  }
  .bundle-strip:hover {
    color: #fff;
  }
  .bundle-strip img {
    flex: none;
    width: 120px;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 12px;
  }
  .bundle-copy {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .bundle-copy strong {
    font-family: var(--font-display);
    font-size: 22px;
    letter-spacing: -0.015em;
  }
  .bundle-copy span {
    font-size: 14px;
    color: #d6d6d6;
  }
  .bundle-price {
    flex: none;
    color: var(--ink);
    font-size: 15px;
    padding: 8px 14px;
  }
  @media (max-width: 640px) {
    .bundle-strip {
      flex-wrap: wrap;
      padding: 12px;
    }
    .bundle-strip img {
      width: 100%;
    }
  }
  .perks {
    border-block: 1.5px solid var(--ink);
    background: var(--paper);
  }
  .perks-grid {
    padding-block: 28px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
  }
  .perk {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .num {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 700;
  }
  .perk p {
    font-size: 14px;
    color: var(--muted);
    margin: 4px 0 0;
  }

  .collections {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
    gap: 20px;
  }
  .panel {
    position: relative;
    overflow: hidden;
    border: 1.5px solid var(--ink);
    border-radius: var(--radius-lg);
    padding: clamp(28px, 4vw, 40px);
    min-height: 380px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: 14px;
  }
  .panel h2 {
    font-size: 56px;
    line-height: 1;
  }
  .panel p {
    margin: 0;
    font-size: 17px;
    max-width: 420px;
    position: relative;
  }
  .panel .kicker {
    color: var(--ink);
    font-size: 13px;
  }
  .panel-ink {
    background: var(--ink);
    color: #fff;
  }
  .panel-ink p {
    color: #e6e6e6;
  }
  .panel-ink .kicker {
    color: var(--lime);
  }
  /* Decoration sits in its own band at the top, so it never runs under the text */
  .decor {
    position: relative;
    align-self: stretch;
    height: 150px;
    margin-bottom: auto;
  }
  .halftone {
    position: absolute;
    right: -70px;
    top: -70px;
    width: 280px;
    height: 280px;
    border-radius: 50%;
    background-image: radial-gradient(var(--ink) 2px, transparent 2.6px);
    background-size: 14px 14px;
    opacity: 0.45;
  }
  .d1 {
    position: absolute;
    right: 0;
    top: 0;
    width: 110px;
    height: 110px;
    border-radius: 50%;
    background: var(--lime);
  }
  .d2 {
    position: absolute;
    right: 55px;
    top: 45px;
    width: 105px;
    height: 105px;
    border-radius: 20px;
    border: 2px solid var(--lilac);
  }

  .lessons {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }
  .lesson {
    text-decoration: none;
    border-top: 1.5px solid var(--ink);
    padding-top: 18px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  .lesson strong {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 24px;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }
  .lesson .text {
    font-size: 15px;
    color: var(--muted);
  }

  .center-head {
    text-align: center;
    margin-bottom: 36px;
  }
  .center-head h2 {
    font-size: clamp(34px, 4.5vw, 48px);
  }
  .center-head p {
    margin: 14px auto 0;
    max-width: 560px;
    font-size: 17px;
    color: var(--body);
  }
  .plans {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }
  .plan {
    border: 1.5px solid var(--ink);
    border-radius: 26px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .plan-white {
    background: var(--paper);
  }
  .plan-lilac {
    background: var(--lilac);
  }
  .plan-ink {
    background: var(--ink);
    color: #fff;
  }
  .plan-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .plan h3 {
    font-size: 22px;
  }
  .plan-ink .pill {
    color: var(--ink);
  }
  .price {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 44px;
    letter-spacing: -0.03em;
  }
  .price span {
    font-size: 16px;
    font-weight: 500;
    letter-spacing: 0;
  }
  .plan ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 15px;
    flex: 1;
  }
  .plan li {
    display: flex;
    gap: 10px;
  }
  .plan li span {
    font-weight: 700;
  }

  .faq {
    max-width: 880px;
  }
  .faq h2 {
    font-size: 40px;
    text-align: center;
    margin-bottom: 24px;
  }
  details {
    border-bottom: 1.5px solid var(--ink);
    padding: 16px 0;
  }
  summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    font-weight: 600;
    font-size: 18px;
    min-height: 44px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary span {
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--lilac);
    display: grid;
    place-items: center;
    transition: transform 0.2s ease;
  }
  details[open] summary span {
    transform: rotate(45deg);
  }
  details p {
    margin: 12px 0 4px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--body);
  }
</style>
