---
import Base from '../layouts/Base.astro';
---

<Base title="License" description="What you can do with Shapeshifters files.">
  <article class="wrap page">
    <p class="kicker">License</p>
    <h1>What you can do with the files</h1>
    <div class="prose">
      <p>[YOUR LICENSE TERMS. Have this checked before launch.]</p>
      <h2>Personal license</h2>
      <p>[What a personal license allows.]</p>
      <h2>Commercial license</h2>
      <p>[What a commercial license allows, e.g. client work, products for sale, limits on reselling the files themselves.]</p>
      <h2>Free packs</h2>
      <p>[Terms for free downloads.]</p>
    </div>
  </article>
</Base>

<style>
  .page {
    max-width: 880px;
    padding-top: 40px;
  }
  h1 {
    font-size: clamp(36px, 5vw, 56px);
    margin-bottom: 16px;
  }
</style>
