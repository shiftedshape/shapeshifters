---
import Base from '../../layouts/Base.astro';
import ShopListing from '../../components/ShopListing.astro';
import JoinBlock from '../../components/JoinBlock.astro';
import { categories, getProducts, type CategoryKey } from '../../lib/catalog';

export function getStaticPaths() {
  return (Object.keys(categories) as CategoryKey[]).map((category) => ({ params: { category } }));
}

const category = Astro.params.category as CategoryKey;
const info = categories[category];
const products = await getProducts((p) => p.data.category === category);
---

<Base title={info.label} description={`${info.label} for Affinity Studio. ${info.title}.`}>
  <ShopListing kicker={info.label} title={info.title} products={products} active={category} />
  <JoinBlock />
</Base>
